export module crumb.gfx.color;
import crumb.core.types;

export namespace crumb {

// 8-bit RGBA color, laid out exactly like one packed 0xRRGGBBAA value.
struct Color {
  ui8 r = 0x00;
  ui8 g = 0x00;
  ui8 b = 0x00;
  ui8 a = 0xFF;
};

inline constexpr Color BLACK       { 0x00, 0x00, 0x00, 0xFF };
inline constexpr Color DARK_BLUE   { 0x1D, 0x2B, 0x53, 0xFF };
inline constexpr Color DARK_PURPLE { 0x7E, 0x25, 0x53, 0xFF };
inline constexpr Color DARK_GREEN  { 0x00, 0x87, 0x51, 0xFF };
inline constexpr Color BROWN       { 0xAB, 0x52, 0x36, 0xFF };
inline constexpr Color DARK_GRAY   { 0x5F, 0x57, 0x4F, 0xFF };
inline constexpr Color LIGHT_GRAY  { 0xC2, 0xC3, 0xC7, 0xFF };
inline constexpr Color WHITE       { 0xFF, 0xF1, 0xE8, 0xFF };
inline constexpr Color RED         { 0xFF, 0x00, 0x4D, 0xFF };
inline constexpr Color ORANGE      { 0xFF, 0xA3, 0x00, 0xFF };
inline constexpr Color YELLOW      { 0xFF, 0xEC, 0x27, 0xFF };
inline constexpr Color GREEN       { 0x00, 0xE4, 0x36, 0xFF };
inline constexpr Color BLUE        { 0x29, 0xAD, 0xFF, 0xFF };
inline constexpr Color INDIGO      { 0x83, 0x76, 0x9C, 0xFF };
inline constexpr Color PINK        { 0xFF, 0x77, 0xA8, 0xFF };
inline constexpr Color PEACH       { 0xFF, 0xCC, 0xAA, 0xFF };

// Utility colors outside the 16-color palette.
inline constexpr Color TRUE_WHITE  { 0xFF, 0xFF, 0xFF, 0xFF };
inline constexpr Color TRANSPARENT { 0x00, 0x00, 0x00, 0x00 };

} // namespace crumb
